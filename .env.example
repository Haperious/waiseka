# Copy to .env (or .env.local) and fill in. Never commit real values.
# See README > Environment Variables for the rest of the app's vars.

# ── Legal pages (/legal/privacy, /legal/terms, /security) ──────────────────
# Every LEGAL_* var is required: `next build` and `next dev` fail if any is
# missing or empty. Set the same values in the Netlify UI before deploying.

# Site the policies cover (Privacy section 1)
LEGAL_WEBSITE_URL=https://example.com
# Privacy / DPO contact and general support inbox
LEGAL_CONTACT_EMAIL=privacy@example.com
# Where security issues are reported (Security page)
LEGAL_SECURITY_EMAIL=security@example.com
# Full postal address for the DPO contact
LEGAL_MAILING_ADDRESS=
# MongoDB Atlas cluster region, e.g. AWS Singapore (ap-southeast-1)
LEGAL_DB_REGION=
# Who sends transactional email (SMTP provider), e.g. Google (Gmail)
LEGAL_EMAIL_PROVIDER=
# Where that provider stores data
LEGAL_EMAIL_PROVIDER_REGION=United States
# How long server logs are kept, in days
LEGAL_LOG_RETENTION_DAYS=30
# How long database backups are kept, in days
LEGAL_BACKUP_RETENTION_DAYS=35
# Inactivity before an account is deleted, e.g. 24 months
LEGAL_INACTIVITY_PERIOD=24 months
# City whose courts handle disputes (Terms), e.g. Quezon City
LEGAL_DISPUTE_CITY=
# Restrictions on a 16-17 account while guardian consent is pending
LEGAL_LIMITED_MODE=Smart Import is off, and the account is deleted after 14 days if your guardian does not confirm
# Effective date shown on every legal page (YYYY-MM-DD)
LEGAL_EFFECTIVE_DATE=2026-10-15

# false = pages reachable by URL but noindex and not linked anywhere.
# true  = indexed and linked from the footer and Settings.
# Keep false until the lawyer signs off and the pending build items exist.
NEXT_PUBLIC_LEGAL_PAGES_PUBLIC=false
