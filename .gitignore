# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude / agent working files
TASKS.md
/memory
/.claude
CLAUDE.md
AGENTS.md

# internal planning docs (PRDs, prompts, notes) — see note in README
*.md
!README.md

# local test + tooling scripts, not part of the deployed app
waiseka_tests.py
seed-announcement.ts
generate-announcement-image.py

# python virtualenv (used only by local announcement-image script)
/.venv
__pycache__/
*.pyc

# editor / IDE
/.vscode
/.idea
*.swp

# OS junk
Thumbs.db
desktop.ini

# local build + dev artifacts
/.netlify
*.local
/dist
/tmp

# one-off design/export artifacts not served by the app
dashboard.html
/docs